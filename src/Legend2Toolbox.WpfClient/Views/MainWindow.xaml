    </Window.Resources>
    <Border Background="{DynamicResource DefaultWindowBackgroundBrush}" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="10"
                Opacity="0.3"
                ShadowDepth="0"
                Color="Black" />
        </Border.Effect>
        <DockPanel>
            <Grid
                Height="30"
                Background="#00ACE3"
                DockPanel.Dock="Top"
                MouseLeftButtonDown="TitleBar_MouseLiftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}, Path=Title}" />
                <Button
                    Grid.Column="1"
                    Click="MinimumButton_Click"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <Path
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource MinimizeIcon}"
                        Fill="White"
                        Stretch="Uniform" />
                </Button>
                <Button
                    Grid.Column="2"
                    Click="CloseButton_Click"
                    Style="{StaticResource CloseButtonStyle}">
                    <Path
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="{StaticResource CloseIcon}"
                        Fill="White"
                        Stretch="Uniform" />
                </Button>
            </Grid>
            <StackPanel
                Background="#00ACE3"
                DockPanel.Dock="Top"
                Orientation="Horizontal">
                <RadioButton IsChecked="{Binding IsLogSelected}" Style="{StaticResource NavRadioButtonStyle}">
                    <StackPanel>
                        <Path
                            Width="40"
                            Height="40"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            Data="{StaticResource LogIcon}"
                            Fill="White"
                            Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Text="系统日志" />
                    </StackPanel>
                </RadioButton>
                <RadioButton IsChecked="{Binding IsSettingsSelected}" Style="{StaticResource NavRadioButtonStyle}">
                    <StackPanel>
                        <Path
                            Width="40"
                            Height="40"
                            Margin="0,0,0,10"
                            VerticalAlignment="Center"
                            Data="{StaticResource SettingIcon}"
                            Fill="White"
                            Stretch="Uniform" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Text="系统设置" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
            <ContentControl Content="{Binding CurrentView}" />
        </DockPanel>
    </Border>
</Window>
